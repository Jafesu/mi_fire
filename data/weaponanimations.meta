<?xml version="1.0" encoding="UTF-8"?>

<!--
  How WEAPON_MINOZZLE is held.

  A nozzle on a charged line is braced at the waist in both hands, which is the minigun stance.
  Mapping a weapon to a stance is exactly what this file is for, and it is the correct fix after
  three attempts to force it with natives all failed:

      SetPedMovementClipset(ped, 'weapons@heavy@minigun')   T-pose
      SetPedStrafeClipset(ped, 'weapons@heavy@minigun')     holds right, T-poses on walking
      both together                                          still T-poses on walking

  The clip set names below are the minigun's own, taken from the game's data. The name was never
  the problem – the natives simply do not reproduce what the weapon animation system does with
  it, which is unsurprising once you see that a weapon entry sets a motion clip set, a weapon
  clip set, a filter, and jump and fall clip sets together.

  ============================================================================================
  FiveM MERGES this file. Tested in game.
  ============================================================================================

  `CWeaponAnimationsSets` is a single global structure, so the open question was whether a second
  one merges into the game's set or replaces it outright. It merges: with this file loaded and
  only WEAPON_MINOZZLE in it, pistols, rifles and ThrowBag's weapon all kept their animations.

  That is worth writing down because the evidence pointed the other way. Both other resources on
  this machine that ship one of these (SmartHose, ThrowBag) carry a full 13,000 line copy of the
  vanilla data with their own entry added, which is only necessary if the file replaces. They had
  copied an approach nobody had checked.

  So: a new weapon needs four lines of animation mapping, not thirteen thousand.

  TO REVERT anyway: delete the `data_file 'WEAPON_ANIMATIONS_FILE'` line from `fxmanifest.lua`
  and its entry in `files`. The stance falls back to the weapon's default, which is the fire
  extinguisher's.
-->
<CWeaponAnimationsSets>
  <WeaponAnimationsSets>
    <Item key="Default">
      <Fallback />
      <WeaponAnimations>
        <Item key="WEAPON_MINOZZLE">
          <CoverMovementClipSetHash />
          <CoverMovementExtraClipSetHash />
          <CoverAlternateMovementClipSetHash />
          <CoverWeaponClipSetHash />
          <MotionClipSetHash>weapons@heavy@minigun</MotionClipSetHash>
          <MotionFilterHash>BothArms_filter</MotionFilterHash>
          <MotionCrouchClipSetHash />
          <MotionStrafingClipSetHash />
          <MotionStrafingStealthClipSetHash />
          <MotionStrafingUpperBodyClipSetHash />
          <WeaponClipSetHash>weapons@heavy@minigun</WeaponClipSetHash>
          <WeaponClipSetStreamedHash />
          <WeaponClipSetHashInjured />
          <WeaponClipSetHashStealth />
          <WeaponClipSetHashHiCover />
          <AlternativeClipSetWhenBlocked />
          <ScopeWeaponClipSet />
          <AlternateAimingStandingClipSetHash />
          <AlternateAimingCrouchingClipSetHash />
          <FiringVariationsStandingClipSetHash />
          <FiringVariationsCrouchingClipSetHash />
          <AimTurnStandingClipSetHash />
          <AimTurnCrouchingClipSetHash />
          <MeleeClipSetHash />
          <MeleeVariationClipSetHash />
          <MeleeTauntClipSetHash />
          <MeleeSupportTauntClipSetHash />
          <MeleeStealthClipSetHash />
          <ShellShockedClipSetHash />
          <JumpUpperbodyClipSetHash>MOVE_JUMP@WEAPONS@RIFLE</JumpUpperbodyClipSetHash>
          <FallUpperbodyClipSetHash>MOVE_FALL@WEAPONS@RIFLE</FallUpperbodyClipSetHash>
          <FromStrafeTransitionUpperBodyClipSetHash>weapons@rifle@</FromStrafeTransitionUpperBodyClipSetHash>
          <SwapWeaponFilterHash />
          <SwapWeaponInLowCoverFilterHash />
          <AnimFireRateModifier value="1.000000" />
          <AnimBlindFireRateModifier value="1.000000" />
          <AnimWantingToShootFireRateModifier value="-1.000000" />
          <UseFromStrafeUpperBodyAimNetwork value="true" />
          <AimingDownTheBarrel value="false" />
          <WeaponSwapData ref="SWAP_DEFAULT" />
          <AimGrenadeThrowNormalClipsetHash />
          <AimGrenadeThrowAlternateClipsetHash />
        </Item>
      </WeaponAnimations>
    </Item>
  </WeaponAnimationsSets>
</CWeaponAnimationsSets>
