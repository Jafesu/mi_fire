<?xml version="1.0" encoding="UTF-8"?>

<!--
  The archetype for the nozzle model.

  This is what makes `w_mi_nozzle` exist as far as the game is concerned. A weapon model without
  one is inert: `CreateWeaponObject` returns 0 and the client looks exactly as though the .ydr
  were missing, however many times anyone reconnects. That symptom cost a round of testing once
  already – see ASSET-001.

  An archetype is only needed because this is a *new* model. A weapon that reuses a base game
  model needs none.

  `txdName` names the texture dictionary. It matches the model name, which is the convention,
  and the textures are embedded in the drawable itself.
-->
<CWeaponModelInfo__InitDataList>
  <InitDatas>
    <Item>
      <modelName>w_mi_nozzle</modelName>
      <txdName>w_mi_nozzle</txdName>
      <ptfxAssetName>NULL</ptfxAssetName>
      <lodDist value="500" />
    </Item>
  </InitDatas>
</CWeaponModelInfo__InitDataList>
